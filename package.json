{
  "name": "multiagent-town",
  "version": "0.1.1-preview.20260907",
  "private": true,
  "type": "module",
  "description": "多智能体社会涌现实验与可视化研究平台",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --no-warnings --import tsx --test \"tests/*.test.ts\"",
    "test:agents:real": "node --no-warnings --import tsx src/cli/real-agent-check.ts",
    "test:dialogue:real": "node --no-warnings --import tsx src/cli/real-dialogue-check.ts",
    "test:dialogue:review": "node --no-warnings --import tsx src/cli/real-dialogue-review-check.ts",
    "test:runtime:real": "node --expose-gc --no-warnings --import tsx src/cli/runtime-soak.ts",
    "test:cognitive:budget": "node --no-warnings --import tsx src/cli/cognitive-budget.ts",
    "typecheck": "tsc --noEmit",
    "town": "node --no-warnings --import tsx src/cli/run.ts",
    "replay": "node --no-warnings --import tsx src/cli/replay.ts",
    "interview": "node --no-warnings --import tsx src/cli/interview.ts",
    "acceptance": "node --no-warnings --import tsx --test tests/acceptance.test.ts",
    "build:web": "node --no-warnings --import tsx scripts/build-web.ts",
    "check:web": "node --no-warnings --import tsx scripts/build-web.ts --check",
    "build:windows": "node scripts/build-windows-exe.mjs",
    "desktop": "pnpm build:web && node --no-warnings --import tsx src/desktop/main.ts",
    "town-web": "pnpm build:web && node --no-warnings --import tsx src/cli/town-web.ts",
    "experiment": "node --no-warnings --import tsx src/cli/experiment.ts",
    "town-agent": "node --no-warnings --import tsx src/cli/town-agent.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
